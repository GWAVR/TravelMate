# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Strong secret key used to sign and verify JWT authentication tokens.
JWT_SECRET="your-strong-production-jwt-secret-key-at-least-32-chars"

# Initial Administrator Credentials (used by server startup & seed script)
ADMIN_EMAIL="abhijeetraoavr@gmail.com"
ADMIN_PASSWORD="your_secure_admin_password_here"
ADMIN_NAME="Abhijeet Rao"

# Optional MySQL Database Configuration
# If provided, TravelMate connects to MySQL. If omitted or unreachable, it gracefully
# uses the local persistent JSON storage engine at data/travelmate_db.json with identical schema.
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_USER="travelmate"
MYSQL_PASSWORD="your_mysql_password"
MYSQL_DATABASE="travelmate_db"
